                style="background-image: url('{{ auth.user.photo }}'); background-size: cover; background-position: center;"
                class="w-12 h-12 rounded-full border"
              >
              </div>
              <div class="flex flex-col">
                @if(auth.isAuthenticated)
                  <span id="nameUser" class="font-semibold">{{ auth.user.fullName }}</span>
                @end
                <span id="emailUser" class="text-sm text-gray-500">{{ auth.user.email }}</span>
              </div>
            </div>
          </a>
