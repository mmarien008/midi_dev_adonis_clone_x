@layout.base({ title: "Time_line" })

@slot('content')

<main>
  <div class=" w-full  flex justify-around border-b">

    <div class="py-4  inline-flex border-b-4 border-blue-500   flex justify-center items-center  text-center">
      Pour toi
    </div>
    <div class="py-4  inline-flex  flex justify-center items-center text-center">
      suivant
    </div>
  </div>
  <form method="post" action="{{ route('tweet.store') }}" id="createTweet-form" enctype="multipart/form-data"
    class=" border-b create flex gap-4 p-4  border-gray-700 text-white">
    <div id="photoInitiateur" class="photo w-12 h-12 rounded-full bg-gray-500">
    </div>
    {{ csrfField() }}
    <div class="block flex-1 flex flex-col gap-3 ">
      <textarea name="contenu" id="contenu"
        class="w-full  bg-transparent text-left resize-none text-lg text-white placeholder-gray-400 focus:outline-none "
        rows="2" placeholder="Exprimez-vous..."></textarea>
      <div class="flex justify-between items-center">
        <div class="actions flex gap-4 text-blue-400">
          <div class="icon flex items-center gap-1 cursor-pointer hover:text-red-500 transition">
            <input name="photos" type="file" />
          </div>
        </div>
        <button type="button submit"
          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded-full font-semibold transition">
          Publier
        </button>
      </div>
    </div>
  </form>

  <div id="tweets" class="h-96 overflow-y-auto flex flex-col">

    @each(tweet in tweets)
    <div class="border-b flex p-4 border-b border-gray-700">
      <div class="w-12 h-12 rounded-full bg-gray-500 mr-3"
        style="background-image: url('{{ tweet.user.photo }}'); background-size: cover; background-position: center;">
      </div>

      <div class="flex-1 flex flex-col">
        <div class="flex gap-2 text-sm justify-between">
          <div>
            <span class="font-bold text-white">{{ tweet.user.fullName }}</span>
            <span class="text-gray-400">{{ tweet.createdAt.toFormat('dd/MM/yyyy HH:mm') }}</span>
          </div>
          @if(tweet.user.id == auth.user.id)

          <div>

            <a href="{{ route('tweet.delete', { id: tweet.id }) }}">
              <span data-id="{{ tweet.id }}" class="text-red-400 delete">Supprimer</span>
            </a>

            <a href="http://">
              <span data-id="{{ tweet.id }}" class="text-blue-400 edit">Éditer</span></a>

          </div>
          @end
        </div>

        <p class="mt-1 text-white w-full break-words">
          {{ tweet.contenu }}
        </p>

        @if(tweet.photo)
        <div class="mt-2 rounded-xl overflow-hidden">
          <img src='{{ tweet.photo }}' alt="media" class="w-full object-cover" />
        </div>
        @end

        <div class="flex justify-between mb-3 mt-4 text-gray-400 text-sm">
          <span class="comment-btn cursor-pointer" data-id="{{ tweet.id }}">{{ tweet.commentaires.length }}💬
            Commenter</span>
          <span>🔁 0</span>
          <span>❤️
          </span>
          <span>📤</span>
        </div>
        <form method="post" action="{{ route('commentaire.store') }}" id="comment-box-{{ tweet.id }}"
          class="hidden mt-3 mb-3">

          <input type="text" class="hidden" name="id_tweet" value="{{ tweet.id }}" />
          {{ csrfField() }}
          <textarea name="contenu" id="comment-input-{{ tweet.id }}" class="w-full bg-gray-800 text-white p-2 rounded"
            placeholder="Écrire un commentaire..."></textarea>
          <button type="submit" class="mt-2 bg-blue-500 hover:bg-blue-600 text-white px-4 py-1 rounded send-comment">
            Commenter
          </button>
        </form>
        @each(commentaire in tweet.commentaires)
        <div class="flex border-b mb-3 ">
          <div class="rounded-full mr-3 h-[40px] w-[40px] border" style="background-image: url('{{ commentaire.user.photo }}'); 
                  background-size: cover; background-position: center;">

          </div>
          <div class=" w-2/3">
            <a href="">{{ commentaire.user.fullName }}</a>
            <span class="text-gray-400">{{ commentaire.createdAt.toFormat('dd/MM/yyyy HH:mm') }}</span>
            <p class="w-full ">
              {{ commentaire.contenu }}
            </p>
            <div class="flex justify-between mb-3 mt-4 text-gray-400 text-sm">
              <span>❤️ 0</span>
              <span>📤</span>
            </div>
          </div>
          @if(commentaire.user.id == auth.user.id)
          <div>
            <a href="{{ route('commentaire.delete', { id: commentaire.id }) }}">
              <span class="text-red-400 ">Supprimer</span>
            </a>
            <a href="">
              <span data-id="{{ tweet.id }}" class="text-blue-400 edit">Éditer</span></a>

          </div>
          @end

        </div>

        @end



      </div>
    </div>

    @end

  </div>

</main>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".comment-btn").forEach(btn => {
      btn.addEventListener("click", e => {
        const id = e.target.dataset.id;
        const commentBox = document.getElementById(`comment-box-${id}`);
        if (commentBox.classList.contains("hidden")) {
          commentBox.classList.remove("hidden");
        } else {
          commentBox.classList.add("hidden");
        }
      });
    });
  });
</script>

@endslot
@end